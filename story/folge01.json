    }
  },
  "scenes": [
    {
      "id": "kalt",
      "pre": 0.8,
      "post": 0.8,
      "lines": [
        {
          "who": "ERZ",
          "text": "Man hat euch erzählt, die Sterne seien Lichter. Dass sie über uns wachen."
        },
        {
          "who": "ERZ",
          "text": "Das ist eine Lüge.",
          "pre": 0.7
        },
        {
          "who": "ERZ",
          "text": "Die Sterne sind Gefängnisse. Und in dieser Nacht … fiel eines davon herab.",
          "pre": 0.8
        }
      ]
    },
    {
      "id": "titel",
      "pre": 4.0,
      "post": 0,
      "lines": []
    },
    {
      "id": "stadt",
      "pre": 0.6,
      "post": 0.6,
      "lines": [
        {
          "who": "ERZ",
          "text": "Aurelion. Die Stadt der tausend Laternen. Magie gab es hier nur für jene, die oben wohnten."
        },
        {
          "who": "ERZ",
          "text": "Elara wohnte unten.",
          "pre": 0.4
        },
        {
          "who": "ELARA",
          "text": "Siehst du, Mama? Alle Laternen brennen.",
          "pre": 0.6
        },
        {
          "who": "ERZ",
          "text": "Ihre Mutter war vor zwölf Jahren verschwunden. In der letzten Nacht, in der ein Stern gefallen war.",
          "pre": 0.5
        }
      ]
    },
    {
      "id": "fall",
      "pre": 4.6,
      "post": 0.4,
      "cues": {
        "streak": 0.3,
        "impact": 3.0
      },
      "lines": [
        {
          "who": "ELARA",
          "text": "Nein … das ist unmöglich."
        }
      ]
    },
    {
      "id": "ruinen",
      "pre": 0.4,
      "post": 0.5,
      "lines": [
        {
          "who": "ERZ",
          "text": "Er schlug in den Ruinen des alten Tempels ein."
        },
        {
          "who": "ERZ",
          "text": "Elara ging trotzdem.",
          "pre": 0.3
        },
        {
          "who": "STERN",
          "text": "Elara.",
          "pre": 1.0
        },
        {
          "who": "ELARA",
          "text": "Wer … wer ist da?",
          "pre": 0.5
        },
        {
          "who": "STERN",
          "text": "Du hast lange gebraucht. Zwölf Jahre, um genau zu sein.",
          "pre": 0.4
        },
        {
          "who": "ELARA",
          "text": "Woher kennst du meinen Namen?",
          "pre": 0.3
        },
        {
          "who": "STERN",
          "text": "Deine Mutter hat ihn mir verraten. Kurz bevor sie mich an den Himmel gekettet hat.",
          "pre": 0.5
        }
      ]
    },
    {
      "id": "bund",
      "pre": 0.3,
      "post": 0.6,
      "cues": {
        "touch": "L1-0.2"
      },
      "lines": [
        {
          "who": "ERZ",
          "text": "Sie hätte weglaufen sollen. Stattdessen berührte sie das Herz des Sterns."
        },
        {
          "who": "STERN",
          "text": "Jetzt gehören wir zusammen. Für immer.",
          "pre": 2.2
        }
      ]
    },
    {
      "id": "orden",
      "pre": 0.3,
      "post": 0.5,
      "lines": [
        {
          "who": "ERZ",
          "text": "Dann kam der Orden der Hohen Flamme."
        },
        {
          "who": "SERAPHINE",
          "text": "Tritt zurück, Kind. Was du da hältst, hat einst eine ganze Welt verbrannt.",
          "pre": 0.5
        },
        {
          "who": "ELARA",
          "text": "Es kennt meinen Namen. Es kennt meine Mutter!",
          "pre": 0.3
        },
        {
          "who": "SERAPHINE",
          "text": "Natürlich kennt es sie.",
          "pre": 0.4
        },
        {
          "who": "SERAPHINE",
          "text": "Es hat sie getötet.",
          "pre": 0.6
        },
        {
          "who": "STERN",
          "text": "Sie lügt, Elara.",
          "pre": 0.5
        }
      ]
    },
    {
      "id": "kael",
      "pre": 0.3,
      "post": 0.4,
      "lines": [
        {
          "who": "SERAPHINE",
          "text": "Hauptmann. Tu deine Pflicht."
        },
        {
          "who": "ERZ",
          "text": "Aus den Reihen des Ordens trat der einzige Mensch, dem Elara je vertraut hatte.",
          "pre": 0.4
        },
        {
          "who": "ELARA",
          "text": "Kael …?",
          "pre": 0.5
        },
        {
          "who": "KAEL",
          "text": "Es tut mir leid, Elara. Wenn der Stern fällt, soll ich dich töten. Das war der Preis für zwölf Jahre Frieden.",
          "pre": 0.5
        },
        {
          "who": "ELARA",
          "text": "Du hast es gewusst. Die ganze Zeit.",
          "pre": 0.4
        },
        {
          "who": "KAEL",
          "text": "Ich habe es gewusst.",
          "pre": 0.4
        },
        {
          "who": "KAEL",
          "text": "Und ich kann es trotzdem nicht.",
          "pre": 0.5
        }
      ]
    },
    {
      "id": "angriff",
      "pre": 0.2,
      "post": 0.4,
      "cues": {
        "bolt": "L1-1.3",
        "fallen": "L1-0.15"
      },
      "lines": [
        {
          "who": "ERZ",
          "text": "Er senkte sein Schwert. Seraphine zögerte keine Sekunde."
        },
        {
          "who": "ELARA",
          "text": "Kael! Nein!",
          "pre": 1.6
        }
      ]
    },
    {
      "id": "abschied",
      "pre": 0.8,
      "post": 0.8,
      "lines": [
        {
          "who": "KAEL",
          "text": "Elara … Mama hat keinen Stern eingesperrt.",
          "rate": 0.9
        },
        {
          "who": "KAEL",
          "text": "Sie hat sich selbst eingesperrt. Damit er niemals freikommt.",
          "pre": 0.6,
          "rate": 0.9
        },
        {
          "who": "ELARA",
          "text": "Wer, Kael? Wer?",
          "pre": 0.4
        },
        {
          "who": "KAEL",
          "text": "Der, den du gerade … in deiner Hand hältst.",
          "pre": 0.5,
          "rate": 0.87
        },
        {
          "who": "ELARA",
          "text": "Bleib bei mir. Bitte. Du bist alles, was ich noch habe.",
          "pre": 1.2,
          "rate": 0.92
        }
      ]
    },
    {
      "id": "erwachen",
      "pre": 0.6,
      "post": 0.5,
      "cues": {
        "schwarz": "L0+2.5",
        "erloeschen": "L2+0.0"
      },
      "lines": [
        {
          "who": "STERN_DUNKEL",
          "text": "Weine nicht, Elara. Du hast ihn nicht verloren. Du hast mich gewonnen."
        },
        {
          "who": "SERAPHINE",
          "text": "Bei allen Göttern … es ist zu spät.",
          "pre": 0.4
        },
        {
          "who": "ERZ",
          "text": "Und einer nach dem anderen erloschen die Sterne über Aurelion.",
          "pre": 0.4
        }
      ]
    },
    {
      "id": "letzter",
      "pre": 0.8,
      "post": 0.6,
      "lines": [
        {
          "who": "ERZ",
          "text": "Alle … bis auf einen."
        },
        {
          "who": "MUTTER",
          "text": "Elara. Hör mir zu. Lass ihn nicht los. Was auch immer er dir verspricht.",
          "pre": 1.0
        },
        {
          "who": "MUTTER",
          "text": "Sonst stirbt die Welt.",
          "pre": 0.5
        }
      ]
    },
    {
      "id": "ende",
      "pre": 0.5,
      "post": 3.2,
      "lines": [
        {
          "who": "ERZ",
          "text": "Manche Gefängnisse halten Monster fest. Andere … die Einzigen, die sie besiegen können."
        }
      ]
    }
  ]
}