  "scenes": [
    {
      "id": "kalt",
      "pre": 0.8,
      "post": 0.9,
      "lines": [
        {
          "who": "ERZ",
          "text": "Man hat euch erzählt, die Sterne seien Lichter, die über uns wachen.",
          "style": "leise, geheimnisvoll"
        },
        {
          "who": "ERZ",
          "text": "Das ist eine Lüge.",
          "pre": 0.7,
          "style": "langsam, mit Gewicht"
        },
        {
          "who": "ERZ",
          "text": "Die Sterne sind Gefängnisse.",
          "pre": 0.6,
          "style": "flüsternd, unheilvoll"
        }
      ]
    },
    {
      "id": "intro",
      "pre": 12.5,
      "post": 0,
      "lines": []
    },
    {
      "id": "welt",
      "pre": 0.8,
      "post": 0.6,
      "lines": [
        {
          "who": "ERZ",
          "text": "Dies ist Valdoria. Eine Welt, in der die Sterne so nah sind, dass man sie singen hört.",
          "style": "staunend, verträumt"
        },
        {
          "who": "ERZ",
          "text": "Inseln schweben über den Wolken. Himmelswale ziehen durch die Nacht.",
          "pre": 0.6,
          "style": "verträumt, sanft"
        },
        {
          "who": "ERZ",
          "text": "Und alle hundert Jahre … fällt ein Stern. Wer sein Licht berührt, erhält Macht über Leben und Tod.",
          "pre": 0.6,
          "style": "ernster werdend, mit Ehrfurcht"
        }
      ]
    },
    {
      "id": "stadt",
      "pre": 0.6,
      "post": 0.6,
      "lines": [
        {
          "who": "ERZ",
          "text": "Aurelion, im Jahr elfhundertsiebenunddreißig nach dem Sternenbund. Die Stadt der tausend Laternen.",
          "style": "erzählend",
          "display": "Aurelion, im Jahr 1137 nach dem Sternenbund. Die Stadt der tausend Laternen."
        },
        {
          "who": "ERZ",
          "text": "Oben herrscht der Orden der Hohen Flamme. Unten lebt Elara.",
          "pre": 0.5,
          "style": "erzählend, mit leiser Bitterkeit"
        },
        {
          "who": "ELARA",
          "text": "Siehst du, Mama? Alle Laternen brennen.",
          "pre": 0.6,
          "style": "sanft, sehnsüchtig, zum Himmel sprechend"
        },
        {
          "who": "ERZ",
          "text": "Ihre Mutter verschwand vor zwölf Jahren. In der Nacht, in der zuletzt ein Stern fiel.",
          "pre": 0.5,
          "style": "leise, traurig"
        },
        {
          "who": "ERZ",
          "text": "Heute Nacht … ist es wieder so weit.",
          "pre": 0.5,
          "style": "flüsternd, spannungsgeladen"
        }
      ]
    },
    {
      "id": "fall",
      "pre": 4.6,
      "post": 0.4,
      "cues": {
        "streak": 0.3,
        "impact": 3.0
      },
      "lines": [
        {
          "who": "ELARA",
          "text": "Nein … das ist unmöglich.",
          "style": "fassungslos, atemlos"
        }
      ]
    },
    {
      "id": "ruinen",
      "pre": 0.4,
      "post": 0.5,
      "lines": [
        {
          "who": "ERZ",
          "text": "Er schlug in den verbotenen Ruinen ein. Elara ging trotzdem.",
          "style": "spannend"
        },
        {
          "who": "STERN",
          "text": "Elara.",
          "pre": 1.0,
          "style": "geflüstert, lockend"
        },
        {
          "who": "ELARA",
          "text": "Wer … wer ist da?",
          "pre": 0.5,
          "style": "ängstlich, leise"
        },
        {
          "who": "STERN",
          "text": "Deine Mutter hat mir deinen Namen verraten. Kurz bevor sie mich an den Himmel gekettet hat.",
          "pre": 0.5,
          "style": "sanft, mit verborgener Bitterkeit"
        }
      ]
    },
    {
      "id": "bund",
      "pre": 0.3,
      "post": 0.6,
      "cues": {
        "touch": "L1-0.2"
      },
      "lines": [
        {
          "who": "ERZ",
          "text": "Sie hätte weglaufen sollen. Stattdessen berührte sie das Herz des Sterns.",
          "style": "eindringlich"
        },
        {
          "who": "STERN",
          "text": "Jetzt gehören wir zusammen. Für immer.",
          "pre": 2.2,
          "style": "zufrieden, hallend"
        }
      ]
    },
    {
      "id": "orden",
      "pre": 0.3,
      "post": 0.5,
      "lines": [
        {
          "who": "ERZ",
          "text": "Dann kam der Orden.",
          "style": "düster"
        },
        {
          "who": "SERAPHINE",
          "text": "Tritt zurück, Kind. Was du da hältst, hat einst eine ganze Welt verbrannt.",
          "pre": 0.5,
          "style": "kalt, gebieterisch"
        },
        {
          "who": "ELARA",
          "text": "Es kennt meine Mutter!",
          "pre": 0.3,
          "style": "verzweifelt, laut"
        },
        {
          "who": "SERAPHINE",
          "text": "Natürlich kennt es sie.",
          "pre": 0.4,
          "style": "ruhig, fast mitleidig"
        },
        {
          "who": "SERAPHINE",
          "text": "Es hat sie getötet.",
          "pre": 0.6,
          "style": "eiskalt, langsam"
        },
        {
          "who": "STERN",
          "text": "Sie lügt, Elara.",
          "pre": 0.5,
          "style": "geflüstert, drängend"
        }
      ]
    },
    {
      "id": "kael",
      "pre": 0.3,
      "post": 0.4,
      "lines": [
        {
          "who": "SERAPHINE",
          "text": "Hauptmann. Tu deine Pflicht.",
          "style": "scharf, befehlend"
        },
        {
          "who": "ELARA",
          "text": "Kael? Du … du gehörst zu ihnen?",
          "pre": 1.4,
          "style": "ungläubig, verletzt"
        },
        {
          "who": "KAEL",
          "text": "Es tut mir leid, Elara. Wenn der Stern fällt, soll ich dich töten. Das war der Preis für zwölf Jahre Frieden.",
          "pre": 0.5,
          "style": "gequält, mit erstickter Stimme"
        },
        {
          "who": "ELARA",
          "text": "Du hast es gewusst. Die ganze Zeit.",
          "pre": 0.4,
          "style": "bitter, den Tränen nahe"
        },
        {
          "who": "KAEL",
          "text": "Ich habe es gewusst.",
          "pre": 0.4,
          "style": "leise, schuldbewusst"
        },
        {
          "who": "KAEL",
          "text": "Und ich kann es trotzdem nicht.",
          "pre": 0.7,
          "style": "entschlossen, mit brechender Stimme"
        }
      ]
    },
    {
      "id": "angriff",
      "pre": 0.2,
      "post": 0.4,
      "cues": {
        "bolt": "L1-1.3",
        "fallen": "L1-0.15"
      },
      "lines": [
        {
          "who": "ERZ",
          "text": "Er senkte sein Schwert. Seraphine zögerte keine Sekunde.",
          "style": "schnell, angespannt"
        },
        {
          "who": "ELARA",
          "text": "Kael! Nein!",
          "pre": 1.6,
          "style": "schreiend, panisch"
        }
      ]
    },
    {
      "id": "abschied",
      "pre": 0.8,
      "post": 0.8,
      "lines": [
        {
          "who": "KAEL",
          "text": "Mama hat keinen Stern eingesperrt …",
          "rate": 0.88,
          "style": "sterbend, schwach, flüsternd"
        },
        {
          "who": "KAEL",
          "text": "Sie hat sich selbst eingesperrt.",
          "pre": 0.6,
          "rate": 0.88,
          "style": "sterbend, flüsternd"
        },
        {
          "who": "ELARA",
          "text": "Warum?",
          "pre": 0.4,
          "style": "weinend"
        },
        {
          "who": "KAEL",
          "text": "Um ihn aufzuhalten. Den, den du gerade … in deiner Hand hältst.",
          "pre": 0.5,
          "rate": 0.86,
          "style": "letzter Atemzug, kaum hörbar"
        },
        {
          "who": "ELARA",
          "text": "Bleib bei mir. Bitte. Du bist alles, was ich noch habe.",
          "pre": 1.2,
          "rate": 0.9,
          "style": "schluchzend, verzweifelt"
        }
      ]
    },
    {
      "id": "erwachen",
      "pre": 0.6,
      "post": 0.5,
      "cues": {
        "schwarz": "L0+2.5",
        "erloeschen": "L2+0.0"
      },
      "lines": [
        {
          "who": "STERN_DUNKEL",
          "text": "Weine nicht, Elara. Du hast ihn nicht verloren. Du hast mich gewonnen.",
          "style": "tief, triumphierend, langsam"
        },
        {
          "who": "SERAPHINE",
          "text": "Bei allen Göttern … es ist zu spät.",
          "pre": 0.4,
          "style": "entsetzt, zum ersten Mal ängstlich"
        },
        {
          "who": "ERZ",
          "text": "Und einer nach dem anderen erloschen die Sterne über Valdoria.",
          "pre": 0.4,
          "style": "düster, langsam"
        }
      ]
    },
    {
      "id": "letzter",
      "pre": 0.8,
      "post": 0.5,
      "cues": {
        "schwester": "L3-0.4"
      },
      "lines": [
        {
          "who": "ERZ",
          "text": "Alle … bis auf einen.",
          "style": "geflüstert"
        },
        {
          "who": "MUTTER",
          "text": "Elara. Hör mir zu. Lass ihn nicht los, was auch immer er dir verspricht.",
          "pre": 1.0,
          "style": "eindringlich, liebevoll, aus weiter Ferne"
        },
        {
          "who": "MUTTER",
          "text": "Sonst stirbt die Welt.",
          "pre": 0.5,
          "style": "ernst, flehend"
        },
        {
          "who": "STERN_DUNKEL",
          "text": "Hallo … Schwester.",
          "pre": 1.6,
          "style": "leise, genüsslich, bedrohlich"
        },
        {
          "who": "ELARA",
          "text": "Schwester …?",
          "pre": 0.8,
          "style": "fassungslos, geflüstert"
        }
      ]
    },
    {
      "id": "ende",
      "pre": 0.5,
      "post": 0.6,
      "lines": [
        {
          "who": "ERZ",
          "text": "Ihre Mutter war kein Mensch.",
          "style": "langsam, schwer"
        },
        {
          "who": "ERZ",
          "text": "Und Elara … war es nur zur Hälfte.",
          "pre": 0.7,
          "style": "flüsternd, die größte Enthüllung"
        }
      ]
    },
    {
      "id": "sting",
      "pre": 0.9,
      "post": 0.8,
      "lines": [
        {
          "who": "SERAPHINE",
          "text": "Findet das Mädchen. Tot oder lebendig.",
          "style": "geflüstert, eiskalt"
        }
      ]
    },
    {
      "id": "abspann",
      "pre": 7.5,
      "post": 0,
      "lines": []
    }
  ]
}