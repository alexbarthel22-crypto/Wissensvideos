        { "id": "L15", "text": "*r:419|Vierhundertneunzehn *r:Millionen / haben *r:gar *r:keine. / Fast die *y:halbe *y:Welt / könnte *y:gar *y:nicht *y:mitspülen.", "pause": 0.2 } ],
