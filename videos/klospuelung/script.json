  "lead_in": 0.9,
  "_zahlen": "~4 Mrd. Menschen nutzen Spültoiletten, ~4 Mrd. nicht (WHO/UNICEF JMP 2023: 3,5 Mrd. ohne sichere Sanitärversorgung). 4 Mrd. x 6 L = 24 Mrd. L; Niagara ~2.400-2.800 m3/s -> ~2,5 h. Meer: 4 Mrd. x ~200 g = 800.000 t. Paris: Mischkanalisation läuft in die Seine über (Olympia 2024).",
  "scenes": [
    { "id": "s01", "tag": "WAS WÄRE WENN · ALLE?", "lines": [
        { "id": "L1", "text": "Was passiert, / wenn *y:alle *y:Menschen / *p:gleichzeitig *p:spülen?", "speed": 0.96 },
        { "id": "L2", "text": "*y:Vier *y:Milliarden Klos. / In *r:einer *r:Sekunde. / Und das Schlimmste / passiert *r:nicht *r:im *r:Klo." } ],
      "sfx": [ { "name": "alarm", "at": "s01+0.0", "volume": 0.6 }, { "name": "pop", "at": "L2:Vier", "volume": 0.45 }, { "name": "impact-bass-1", "at": "L2:nicht", "volume": 0.35 } ] },
    { "id": "s02", "tag": "SEKUNDE 0 · WASSER", "lines": [
        { "id": "L3", "text": "Jede Spülung: / rund *b:sechs *b:Liter. / Zusammen: / *y:24|vierundzwanzig *y:Milliarden *y:Liter." },
        { "id": "L4", "text": "So viel, / wie die *b:Niagarafälle / in *r:über *r:zwei *r:Stunden / hinunterstürzen." } ],
      "sfx": [ { "name": "pop", "at": "L3:24", "volume": 0.45 }, { "name": "impact-bass-2", "at": "L4:über", "volume": 0.3 } ] },
    { "id": "s03", "tag": "SEKUNDE 5 · DRUCK", "lines": [
        { "id": "L5", "text": "Alle Spülkästen / füllen sich *r:gleichzeitig. / Der *r:Wasserdruck / bricht ein." },
        { "id": "L6", "text": "Im Hochhaus / kommt ab dem *r:zehnten *r:Stock / *r:nichts *r:mehr. / Und wer gerade duscht …", "pause": 0.2 },
        { "id": "L7", "text": "… bekommt plötzlich / *r:brühend *r:heißes Wasser.", "pause": 0.3 } ],
      "sfx": [ { "name": "error", "at": "L5:bricht", "volume": 0.3 }, { "name": "glitch-1", "at": "L7:brühend", "volume": 0.25 } ] },
    { "id": "s04", "tag": "MINUTE 2 · KANAL", "lines": [
        { "id": "L8", "text": "Dann die Kanalisation. / Gebaut für *y:normale *y:Tage – / nicht für *r:alle *r:auf *r:einmal." },
        { "id": "L9", "text": "*r:Klärwerke laufen über. / Ungeklärtes Abwasser / fließt *r:direkt *r:in *r:Flüsse. / *r:Fische *r:sterben." } ],
      "sfx": [ { "name": "impact-bass-1", "at": "L9:Klärwerke", "volume": 0.3 }, { "name": "error", "at": "L9:Fische", "volume": 0.25 } ] },
    { "id": "s05", "tag": "MINUTE 10 · PARIS", "lines": [
        { "id": "L10", "text": "Und in *y:Paris? / *r:Gullydeckel *r:fliegen. / Abwasser / *r:flutet *r:die *r:Straßen." },
        { "id": "L11", "text": "Die *b:Seine wird / zur *r:Kloake – / wie schon bei den / *y:Olympischen *y:Spielen." } ],
      "sfx": [ { "name": "impact-bass-2", "at": "L10:Gullydeckel", "volume": 0.35 }, { "name": "glitch-1", "at": "L11:Kloake", "volume": 0.25 } ] },
    { "id": "s06", "tag": "GLEICHZEITIG · MEER", "lines": [
        { "id": "L12", "text": "Und die *y:andere *y:Hälfte? / *y:Vier *y:Milliarden Menschen / ohne Spülung / gehen *b:ins *b:Meer." },
        { "id": "L13", "text": "Wer im Inland wohnt, / steht im *r:größten *r:Stau / der Geschichte." },
        { "id": "L14", "text": "Am Strand: / *r:800.000|achthunderttausend *r:Tonnen / auf *r:einen *r:Schlag. / Die *g:Algen *r:explodieren." } ],
      "sfx": [ { "name": "whoosh-short", "at": "L12:Meer", "volume": 0.35 }, { "name": "error", "at": "L13:Stau", "volume": 0.3 }, { "name": "impact-bass-1", "at": "L14:800.000", "volume": 0.35 } ] },
    { "id": "s07", "tag": "WOCHE 1 · GELD", "lines": [
        { "id": "L15", "text": "Und dann: / *r:Badeverbot an allen Küsten. / *r:Fischfang *r:gestoppt. / *r:Urlaub *r:storniert." },
        { "id": "L16", "text": "Ein paar Sekunden Spülen – / *r:Milliarden *r:Verlust / für den *y:Tourismus." } ],
      "sfx": [ { "name": "error", "at": "L15:Badeverbot", "volume": 0.3 }, { "name": "notification", "at": "L16:Milliarden", "volume": 0.3 } ] },
    { "id": "s08", "tag": "UND DU?", "hold": 2.8, "lines": [
        { "id": "L17", "text": "Und *y:du? / Spülst du / *p:nach *p:jedem *p:Gang – / oder *g:seltener? / Schreib's in die *y:Kommentare!", "pause": 0.3 },
        { "id": "L18", "text": "Und *p:folg *p:mir / für mehr – / sonst *r:explodiert *r:dein *r:Klo / *r:heute *r:Abend.", "pause": 0.3 } ],
      "sfx": [ { "name": "notification", "at": "L17:Kommentare", "volume": 0.4 }, { "name": "impact-bass-2", "at": "L18:explodiert", "volume": 0.4 } ] }
  ]
}
